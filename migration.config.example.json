{
  "_comment": "Migration config. Everything project-specific lives here; the tools in tools/ are project-agnostic and read this file.",
  "prefix": "mytheme",
  "_prefix": "Theme function prefix (mytheme_field, mytheme_menu_items...). Use your project name.",
  "paths": {
    "nextExport": "../source-nextjs/out",
    "nextBuild": "../source-nextjs",
    "theme": "../theme",
    "tests": "../tests"
  },
  "menu": [
    {
      "label": "About",
      "url": "/about/"
    },
    {
      "label": "Shop",
      "url": "/shop/"
    },
    {
      "label": "Contact",
      "url": "/contact/"
    }
  ],
  "_menu": "Menu items from the original. Used as a fallback in the template: if the client never assigns a WordPress menu, the navigation still renders.",
  "routes": {
    "_comment": "Export file -> route and WordPress template name. Template names must follow the WP hierarchy: front-page, page-<slug>, single-<post_type>, 404.",
    "index.html": {
      "slug": "home",
      "route": "/",
      "title": "Home",
      "template": "front-page"
    },
    "about.html": {
      "slug": "about",
      "route": "/about/",
      "title": "About",
      "template": "page-about"
    },
    "shop/product-a.html": {
      "slug": "product-a",
      "route": "/shop/product-a/",
      "title": "Product A",
      "template": "single-product"
    },
    "shop/product-b.html": {
      "slug": "product-b",
      "route": "/shop/product-b/",
      "title": "Product B",
      "template": "single-product"
    },
    "_not-found.html": {
      "slug": "404",
      "route": "/404/",
      "title": "Not found",
      "template": "404"
    }
  },
  "postTypes": {
    "_comment": "A template shared by several pages becomes a post type: the client adds an entry instead of asking for a new subpage.",
    "product": {
      "label": "Products",
      "singularLabel": "Product",
      "rewriteSlug": "shop",
      "supports": [
        "title",
        "thumbnail"
      ],
      "icon": "dashicons-cart"
    }
  },
  "clientOnlyComponents": {
    "_comment": "Elements Next renders only on the client — absent from the static export. The selector runs in the browser against the LIVE old site.",
    "consent-banner": {
      "find": "Array.from(document.querySelectorAll('div')).find(e => /Accept|cookie/i.test(e.textContent) && getComputedStyle(e).position === 'fixed')",
      "wire": [
        {
          "search": "<div role=\"dialog\"",
          "replace": "<div data-consent hidden role=\"dialog\""
        }
      ]
    },
    "mobile-cta-bar": {
      "viewport": {
        "width": 375,
        "height": 812
      },
      "find": "Array.from(document.querySelectorAll('div')).find(e => getComputedStyle(e).position === 'fixed' && e.querySelector('a[href^=\"tel:\"]'))",
      "wire": [
        {
          "search": "^<div ",
          "replace": "<div data-mobile-cta ",
          "regex": true
        }
      ]
    }
  },
  "fieldMap": {
    "_comment": "Fill this in AFTER running find-variants.mjs, which prints which texts differ between pages sharing a template. A number is a variant index; a string is a value identical on every page that still belongs to the repeater.",
    "single-product": {
      "post_type": "product",
      "title": 10,
      "scalars": {
        "h1": 12,
        "intro": 13
      },
      "repeaters": {
        "features": {
          "sub": "feature",
          "indexes": [
            20,
            21,
            22
          ]
        },
        "sections": {
          "pairs": true,
          "sub": [
            "title",
            "body"
          ],
          "indexes": [
            [
              30,
              31
            ],
            [
              32,
              33
            ]
          ]
        }
      },
      "wysiwyg": {
        "_comment": "Optional. A container holding arbitrary HTML (paragraphs, lists) becomes a WYSIWYG repeater.",
        "container": "space-y-8",
        "field": "sections",
        "subfields": [
          "title",
          "body"
        ]
      },
      "linkRewrites": [
        {
          "_comment": "Optional. Rewrites URLs frozen from the source page. Most specific first.",
          "match": "https://wa\\\\.me/[^\"]*%3A[^\"]*",
          "php": "<?php echo esc_url( mytheme_contact_url( get_field( 'type' ) ) ); ?>"
        }
      ]
    }
  }
}